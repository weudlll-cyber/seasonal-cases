# @file   ops/compose.dev.env
# @brief  Local ports and development-only credentials for ops/compose.dev.yml.
#
# Responsibility: make the dev stack start without setup. Development only: everything listens
#                 on 127.0.0.1. The password is not a secret: it guards a local database only.
# Used by:        ops/compose.dev.yml (docker compose --env-file), apps/server/dev.env
#
# Ports of this project: 5570 PostgreSQL, 1170 Mailpit SMTP, 8570 Mailpit web UI
# (server 3970, client 5470; browser tests 3980, 5480, 3990, 5485).

SC_DEV_POSTGRES_PORT=5570
SC_DEV_MAILPIT_SMTP_PORT=1170
SC_DEV_MAILPIT_UI_PORT=8570

POSTGRES_USER=sc
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=sc
