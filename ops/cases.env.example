# @file   ops/cases.env.example
# @brief  The settings of an installed game, without secrets: what deploy/install.sh writes to
#         /etc/seasonal-cases/cases.env (root, 0600). docs/CONFIG.md explains each variable.
#
# The first block is read by docker compose (ops/compose*.yml); all of it reaches the game.

SC_IMAGE=seasonal-cases:v1.1.0
SC_ENV_FILE=/etc/seasonal-cases/cases.env
# The loopback port the game is published on, for the server's own proxy.
SC_HOST_PORT=3970
SC_EDGE_SUBNET=172.30.251.0/24
# Website mode only: the website's Docker network.
# SC_WEBSITE_NETWORK=seasonal-site_default
# Secret: the database's password (the installer makes it).
POSTGRES_PASSWORD=

SC_MODE=local
# Secrets: made once by the installer, then kept. Losing the data or recovery key loses what they
# sealed: they travel inside every backup.
SC_DATA_KEY=
SC_COOKIE_SECRET=
SC_RECOVERY_KEY=
# Addresses whose X-Forwarded-For names the visitor: local mode, the compose network's gateway
# (where the host proxy's connections come from).
SC_TRUSTED_PROXIES=172.30.251.1
# Local mode:
SC_PUBLIC_ORIGIN=https://cases.example.org
# SC_SMTP_HOST=
# SC_SMTP_PORT=25
# SC_MAIL_FROM=Seasonal Cases <cases@example.org>
# SC_PRIVACY_CONTACT=
# Website mode:
# SC_WEBSITE_ORIGIN=https://example.org
# SC_PROXY_SECRET=
# SC_WEBSITE_LOCAL_ORIGIN=http://site:3800
# SC_GAMES_SYNC_TOKEN=
