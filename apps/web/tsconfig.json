/**
 * @file   apps/web/tsconfig.json
 * @brief  TypeScript settings for @sc/web.
 *
 * Responsibility: extend the bundler base; include src/ and the Vite config; opt into the React
 *                 JSX runtime. Node types only for vite.config.ts (process.env).
 */
{
  "extends": "../../tsconfig.bundler.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
