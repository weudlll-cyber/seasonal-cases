    "@zxcvbn-ts/language-common": "4.2.0",
    "fastify": "5.12.7",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
