# @file   apps/server/dev.env
# @brief  Settings of `pnpm dev`: development mode with the development features on.
#
# Responsibility: the development sign-in and admin API exist only with both values set
#                 (CONCEPT §10, SECURITY.md); never on a public address. A variable already set
#                 in the shell wins (node --env-file never overrides).
# Used by:        apps/server/package.json (script "dev"), the root `pnpm dev`
NODE_ENV=development
SC_DEV=1
# The website's development server on this PC: its chat appears docked under the screens
# (local mode only; README "The website's chat while developing").
SC_CHAT_ORIGIN=http://localhost:5380
