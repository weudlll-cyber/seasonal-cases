/**
 * @file   tsconfig.base.json
 * @brief  Strict TypeScript base shared by every workspace project.
 *
 * Responsibility: one set of compiler checks for the whole repo; NodeNext resolution for
 *                 the server and the shared packages. Browser projects use tsconfig.bundler.json.
 * Used by:        tsconfig.bundler.json, packages/{contracts,domain,application}, apps/server
 */
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // No ambient @types leak into a project; each one opts in to what it needs (e.g. node).
    "types": [],
    // Packages are consumed as source until a build step exists. The aliases also let ESLint's
    // boundaries rule resolve "@sc/<name>" imports and check them against the layer rules.
    "paths": {
      "@sc/*": ["./packages/*/src/index.ts"]
    }
  }
}
